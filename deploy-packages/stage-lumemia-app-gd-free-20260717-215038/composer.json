{
    "name": "lumemia/coffee-backend",
    "description": "Lume Mia Coffee — vanilla PHP 8 backend.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-mysqli": "*"
    },
    "autoload": {
        "psr-4": {
            "Lumemia\\": "src/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "minimum-stability": "stable"
}
